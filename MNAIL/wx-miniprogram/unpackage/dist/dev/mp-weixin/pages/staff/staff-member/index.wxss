
.page.data-v-a7b132eb {
  background: #f7f7f7;
  min-height: 100vh;
}
.top-bar.data-v-a7b132eb {
  display: flex;
  padding: 20rpx;
  gap: 10rpx;
  background: #fff;
}
.search-input.data-v-a7b132eb {
  flex: 1;
  height: 70rpx;
  border-radius: 50rpx;
  background: #f5f5f5;
  padding: 0 20rpx;
}
.sort-btn.data-v-a7b132eb {
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
}
.add-btn.data-v-a7b132eb {
  background: #ff5a94;
  color: #fff;
  font-size: 24rpx;
  border-radius: 10rpx;
}

/* 会员列表 */
.item.data-v-a7b132eb {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.name.data-v-a7b132eb {
  font-size: 30rpx;
  font-weight: bold;
}
.level.data-v-a7b132eb {
  background: #ff5a94;
  color: #fff;
  padding: 6rpx 12rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
}
.balance.data-v-a7b132eb {
  color: #ff5a94;
  font-size: 30rpx;
  font-weight: bold;
}

/* 弹窗 */
.mask.data-v-a7b132eb {
  position: fixed; top:0;left:0;right:0;bottom:0;
  background: rgba(0,0,0,0.5);
  z-index: 99;
}
.detail-popup.data-v-a7b132eb,
.form-popup.data-v-a7b132eb,
.sort-popup.data-v-a7b132eb {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%,-50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  z-index: 100;
}
.title.data-v-a7b132eb {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}
.row.data-v-a7b132eb {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
input.data-v-a7b132eb, .picker.data-v-a7b132eb {
  border: 1rpx solid #eee;
  height: 80rpx;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
}

/* 充值扣款按钮 */
.money-btns.data-v-a7b132eb {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.money-btns button.data-v-a7b132eb {
  flex: 1;
  color: #fff;
  border-radius: 12rpx;
}
.green.data-v-a7b132eb {
  background: #00b42a;
}
.red.data-v-a7b132eb {
  background: #ff5a94;
}
.btns.data-v-a7b132eb {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 20rpx;
}
.s-item.data-v-a7b132eb {
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
}
